api.sync.acerola.app {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    # Swarm service of the hetzner_acerola-sync stack, over the edge network.
    reverse_proxy hetzner_acerola-sync_server:3000

    encode zstd gzip

    log {
        output file /data/acerola-sync-access.log
        format json
    }
}
